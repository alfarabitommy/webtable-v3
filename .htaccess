# Phase 10D (WS-5) + Plan 34: reCAPTCHA secret TIDAK boleh ada di repo.
# Secret (RECAPTCHA_SECRET) dan site key (RECAPTCHA_SITE_KEY) wajib dari
# environment server (FPM pool env[] / nginx fastcgi_param / shell export).
#
# Dev lokal (Apache vhost synapse.test) — contoh, AKTIFKAN di vhost lokal saja:
SetEnv CI_ENV "development"
#
# Production: CI_ENV harus 'production' (default fail-closed bila unset, lihat index.php).

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]

<IfModule mod_rewrite.c>

SetEnv CI_ENV "development"

RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>